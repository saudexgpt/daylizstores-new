  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "watch": "vite build --watch",
    "build": "vite build",
    "prod": "vite build",
    "production": "vite build",
    "lint": "eslint --ext .js,.vue resources/js",
    "test:js": "node --experimental-default-type=module --test \"tests/js/**/*.test.mjs\""
