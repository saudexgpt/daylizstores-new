    "eslint-plugin-vue": "^9.27.0",
    "fast-glob": "^3.3.3",
    "husky": "^3.0.5",
    "laravel-vite-plugin": "^2.1.0",
    "lint-staged": "^9.2.5",
    "sass": "^1.101.0",
    "vite": "^7.3.6",
    "vite-plugin-svg-icons": "^2.0.1"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
