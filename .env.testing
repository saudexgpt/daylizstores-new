APP_NAME='Dayliz Stores'
APP_ENV=testing
APP_KEY=base64:KIYtXgSfBNi7337Gs8UttYqthTwqddsGfhaOs1W9L8Y=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Dedicated, isolated test database — never point this at the real `ecommerce`
# database. Tests use RefreshDatabase, which wipes and re-migrates this DB on
# every run.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_testing
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

MAIL_DRIVER=array

BCRYPT_ROUNDS=4

BASE_API=/api
